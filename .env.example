# Copy to .env and adjust. NEVER commit a real .env or any API key.

# Server
PORT=3000

# LLM provider: "ollama" (local, default) or "anthropic" (swappable quality fallback)
LLM_PROVIDER=ollama

# Ollama (local) — no key required
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b-instruct

# Anthropic (only if LLM_PROVIDER=anthropic) — supply via real .env, never commit
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Persistence (SQLite file)
DB_PATH=./data/eduwave.db

# Provider call timeout (ms)
LLM_TIMEOUT_MS=30000
